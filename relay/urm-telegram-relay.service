[Unit]
Description=URM Telegram WSS Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/urm-telegram-relay.env
ExecStart=/usr/bin/python3 /opt/urm-telegram-relay/telegram_ws_relay.py
Restart=on-failure
RestartSec=3
User=nobody
Group=nogroup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
